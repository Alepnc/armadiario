# ─────────────────────────────────────────────────────────────────────────────
# ArmadiarIo — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else is
# server-only and must stay secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC ───────────────────────────────────────────────────────────────────
# Supabase project URL and anon/publishable key (Project settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Product name (easy to change). Default: "ArmadiarIo"
NEXT_PUBLIC_APP_NAME=ArmadiarIo
# Public origin of the site, used in e-mail links (confirmation / reset).
# Optional: derived from the request when empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SERVER ONLY ──────────────────────────────────────────────────────────────
# Supabase service-role key. Used ONLY to delete an account (auth user + files).
# Without it, "Elimina account" is disabled. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers. Each capability is configured independently; any of them can be
# left empty or set to "none" and the app keeps working (see README).
#   Garment photo analysis (multimodal):   AI_ANALYSIS_PROVIDER = anthropic | gemini | none
#   Natural-language + outfit explanation: AI_STYLIST_PROVIDER  = anthropic | gemini | none
# If left unset, the provider that has a key is used (Anthropic first, then Gemini).
# Gemini has a FREE tier (aistudio.google.com/apikey) — but on the free tier Google may use the
# content you send to improve its products. See README → Provider AI.
AI_ANALYSIS_PROVIDER=
AI_STYLIST_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_ANALYSIS_MODEL=claude-haiku-5-5
ANTHROPIC_STYLIST_MODEL=claude-sonnet-5-5

# Google Gemini (free tier available).
GEMINI_API_KEY=
GEMINI_STYLIST_MODEL=gemini-3.5-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
# Reserve model, used when the main one is overloaded or too slow.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Virtual try-on (image generation). Provider: replicate | none
TRYON_PROVIDER=replicate
REPLICATE_API_TOKEN=
# Version hash of an IDM-VTON compatible model on Replicate (see README).
REPLICATE_TRYON_VERSION=
# Only if your model uses different input names:
# REPLICATE_TRYON_HUMAN_FIELD=human_img
# REPLICATE_TRYON_GARMENT_FIELD=garm_img

# Per-user quotas for costly AI operations (rolling windows).
AI_LIMIT_ANALYZE_PER_HOUR=60
AI_LIMIT_OUTFIT_PER_HOUR=30
AI_LIMIT_TRYON_PER_DAY=10
